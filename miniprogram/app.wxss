/* iOS-inspired grouped interface. System fonts only; no remote assets. */
/* Override the native default button width; each layout owns its sizing. */
button{width:auto!important;max-width:none;margin-left:0!important;margin-right:0!important}
page{--page:#f2f2f7;--paper:#fff;--ink:#1c1c1e;--secondary:#636366;--tertiary:#8e8e93;--blue:#007aff;--line:#e5e5ea;background:var(--page);color:var(--ink);font-size:28rpx;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}
view,text,input,textarea,picker,button,scroll-view{box-sizing:border-box}button{font:inherit;border-radius:22rpx;margin:0;line-height:1.4;min-height:88rpx;padding:22rpx 28rpx;background:#f2f2f7;color:#007aff}button::after{border:0}button[disabled]{opacity:.42}button:active{opacity:.72;transform:scale(.985)}input,textarea{font:inherit;color:var(--ink)}.primary{background:#007aff;color:#fff;font-weight:600;border-radius:24rpx}.secondary{background:#eef5ff;color:#007aff;font-weight:600;border-radius:24rpx}.quiet-button{background:transparent;color:#007aff;padding:8rpx 0;min-height:64rpx;font-size:26rpx}.muted{color:#8e8e93}.card{background:#fff;border-radius:32rpx;overflow:hidden;box-shadow:0 5rpx 24rpx rgba(28,28,30,.025)}.page-heading{padding:24rpx 36rpx 28rpx}.date-label,.eyebrow{font-size:23rpx;font-weight:600;color:#8e8e93;letter-spacing:1rpx}.page-heading-row{display:flex;align-items:center;justify-content:space-between;gap:22rpx;margin-top:8rpx}.large-title{font-size:64rpx;line-height:1.2;font-weight:750;letter-spacing:-2rpx;color:#1c1c1e}.page-caption{font-size:25rpx;color:#8e8e93;margin-top:14rpx;line-height:1.6}.section-heading{display:flex;justify-content:space-between;align-items:center;margin:36rpx 36rpx 16rpx;gap:20rpx}.section-heading>text:first-child{font-size:34rpx;font-weight:700;letter-spacing:-.6rpx}.section-heading .section-link{font-size:25rpx;font-weight:400;color:#007aff}.group-label{margin:32rpx 40rpx 12rpx;font-size:24rpx;color:#636366;font-weight:500}.group-note{margin:14rpx 40rpx 26rpx;color:#8e8e93;font-size:23rpx;line-height:1.7}.pill{display:inline-block;flex-shrink:0;padding:6rpx 16rpx;border-radius:30rpx;font-size:21rpx;font-weight:600;background:#f2f2f7;color:#636366}.pill.wait{background:#fff4df;color:#956000}.pill.run{background:#eaf3ff;color:#0063d0}.pill.done{background:#e8f8ef;color:#168346}.pill.red{background:#fff0ee;color:#c43f36}.pill.blue{background:#edf4ff;color:#007aff}.chevron{width:13rpx;height:13rpx;border-top:3rpx solid #c7c7cc;border-right:3rpx solid #c7c7cc;transform:rotate(45deg);flex-shrink:0;margin:0 6rpx}.icon-tile{width:66rpx;height:66rpx;border-radius:21rpx;display:flex;align-items:center;justify-content:center;flex-shrink:0}.icon-tile.blue{background:#007aff;color:#fff}.icon-tile.orange{background:#ff9500;color:#fff}.icon-tile.green{background:#34c759;color:#fff}.icon-tile.purple{background:#af52de;color:#fff}.icon{display:block;position:relative;width:32rpx;height:32rpx;flex-shrink:0}.icon.plus::before,.icon.plus::after{content:"";position:absolute;background:currentColor;border-radius:3rpx;left:4rpx;top:15rpx;width:26rpx;height:3rpx}.icon.plus::after{transform:rotate(90deg)}.icon.list{border:3rpx solid currentColor;border-radius:7rpx}.icon.list::after{content:"";position:absolute;left:6rpx;right:6rpx;top:8rpx;height:3rpx;background:currentColor;box-shadow:0 8rpx 0 currentColor}.icon.calendar{border:3rpx solid currentColor;border-radius:7rpx}.icon.calendar::before{content:"";position:absolute;left:-2rpx;right:-2rpx;top:7rpx;border-bottom:3rpx solid currentColor}.icon.calendar::after{content:"";position:absolute;left:7rpx;top:15rpx;width:5rpx;height:5rpx;border-radius:2rpx;background:currentColor;box-shadow:8rpx 0 0 currentColor}.icon.bell{width:27rpx;height:28rpx;border:3rpx solid currentColor;border-radius:15rpx 15rpx 5rpx 5rpx;margin-top:-5rpx}.icon.bell::after{content:"";position:absolute;bottom:-8rpx;left:7rpx;width:7rpx;height:3rpx;background:currentColor;border-radius:3rpx}.icon.people::before{content:"";position:absolute;top:0;left:11rpx;width:12rpx;height:12rpx;border:3rpx solid currentColor;border-radius:50%}.icon.people::after{content:"";position:absolute;bottom:0;left:3rpx;width:28rpx;height:15rpx;border:3rpx solid currentColor;border-radius:16rpx 16rpx 4rpx 4rpx}.icon.cloud{border:3rpx solid currentColor;border-radius:15rpx;width:34rpx;height:21rpx;margin-top:9rpx}.icon.cloud::before{content:"";position:absolute;top:-11rpx;left:7rpx;width:18rpx;height:18rpx;border:3rpx solid currentColor;border-bottom:0;border-radius:50%;background:inherit}.icon.search{width:24rpx;height:24rpx;border:3rpx solid currentColor;border-radius:50%;margin-right:8rpx}.icon.search::after{content:"";width:12rpx;height:3rpx;background:currentColor;position:absolute;right:-9rpx;bottom:-5rpx;transform:rotate(45deg);border-radius:3rpx}.empty-symbol{width:112rpx;height:112rpx;border-radius:32rpx;background:#eef5ff;color:#007aff;display:flex;align-items:center;justify-content:center;margin:0 auto 26rpx}.empty-symbol .icon{transform:scale(1.35)}.empty-title{font-size:30rpx;font-weight:600;color:#1c1c1e}.empty-caption{font-size:25rpx;color:#8e8e93;line-height:1.7;margin-top:10rpx}.group-card{margin:0 28rpx;padding:8rpx 28rpx;background:#fff;border-radius:28rpx;overflow:hidden}.field{margin:0;border-bottom:1rpx solid #ededf0;padding:22rpx 0}.field:last-child{border-bottom:0}.field>text{font-size:25rpx;color:#636366;display:block;margin-bottom:9rpx}.field input,.field .picker-field{height:62rpx;min-height:62rpx;padding:0;background:transparent;border:0;width:100%;font-size:29rpx;color:#1c1c1e;line-height:62rpx}.picker-field{display:flex;justify-content:space-between;align-items:center;gap:18rpx}.picker-field .placeholder{color:#c7c7cc}.field textarea{width:100%;min-height:140rpx;height:140rpx;line-height:1.7;font-size:28rpx;padding:0;background:transparent;border:0}.two,.two-inputs{display:flex;gap:28rpx}.two input,.two-inputs input{width:50%;min-width:0}.tip,.notice,.footnote{font-size:23rpx;line-height:1.75;color:#8e8e93}.notice{margin:18rpx 0;word-break:break-word}.center{text-align:center}.red-text{color:#c83b31}.muted-text{font-size:24rpx;color:#8e8e93}.section-title{font-size:32rpx;font-weight:650;letter-spacing:-.5rpx;margin:8rpx 0 20rpx}.actions{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:22rpx}.actions button{font-size:25rpx;min-height:76rpx;padding:18rpx 22rpx;border-radius:20rpx}.actions .primary{color:#fff}.footer-note{color:#8e8e93;font-size:21rpx;text-align:center;padding:28rpx 32rpx;line-height:1.75}@media(min-width:600px){.screen,.detail-screen{max-width:1000rpx;margin-left:auto;margin-right:auto}}
