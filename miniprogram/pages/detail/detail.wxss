.detail-screen{min-height:100vh;padding-bottom:28rpx}.detail-title{font-size:51rpx;line-height:1.3;font-weight:750;letter-spacing:-1.5rpx;margin-top:12rpx;word-break:break-word}.progress{margin:0 28rpx;padding:27rpx 28rpx}.picker-state{display:flex;justify-content:space-between;gap:24rpx;align-items:center}.progress-caption{color:#8e8e93;font-size:24rpx;margin-bottom:6rpx}.picker-state>view>text{font-size:42rpx;font-weight:700;color:#007aff;letter-spacing:-1rpx}.state-accessory{display:flex;align-items:center;gap:18rpx;color:#8e8e93;font-size:24rpx;flex-shrink:0}.progress-btn{width:100%;font-size:27rpx;margin-top:24rpx;min-height:82rpx}.source{margin:0 28rpx;padding:26rpx 28rpx}.source-heading{font-size:24rpx;color:#8e8e93;margin:0 0 12rpx}.source-heading:not(:first-child){margin-top:26rpx}.source>text{font-size:27rpx;line-height:1.85;white-space:pre-wrap;word-break:break-word;color:#3a3a3c}.history{display:flex;align-items:flex-start;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid #ededf0}.history:last-child{border-bottom:0}.history-dot{width:12rpx;height:12rpx;border-radius:50%;background:#007aff;flex-shrink:0;margin-top:13rpx}.history-content{min-width:0;flex:1}.history-content>text{font-size:26rpx;display:block;color:#3a3a3c}.history-content .history-at{font-size:21rpx;color:#8e8e93;margin-top:7rpx;word-break:break-all}.delete-card{margin:30rpx 28rpx 0;background:#fff;border-radius:26rpx}.delete{color:#d83b32;background:#fff;width:100%;font-size:28rpx}.footnote{margin:22rpx 42rpx}.detail-bottom-space{height:140rpx;padding-bottom:env(safe-area-inset-bottom)}.save-dock{position:fixed;left:0;right:0;bottom:0;background:rgba(242,242,247,.96);padding:20rpx 28rpx;padding-bottom:calc(20rpx + env(safe-area-inset-bottom));z-index:20;border-top:1rpx solid #e5e5ea;backdrop-filter:blur(20px)}.save-dock .primary{width:100%;min-height:96rpx;font-size:29rpx}

.progress-btn,.delete,.save-dock .primary{width:100%!important}
