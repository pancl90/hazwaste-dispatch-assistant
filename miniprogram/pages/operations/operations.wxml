<view class="detail-screen operations-screen">
  <view class="page-heading"><view class="eyebrow">清运智办</view><view class="page-heading-row"><view class="large-title">{{tab==='reminders'?'提醒中心':tab==='customers'?'客户档案':'同步与备份'}}</view><view wx:if="{{tab==='reminders'}}" class="heading-count">{{unread}}</view><button wx:if="{{tab==='customers'}}" class="add-customer" bindtap="newCustomer"><view class="icon plus"></view></button></view><view class="page-caption">{{sessionLabel}}</view></view>
  <view class="segmented"><button data-tab="reminders" bindtap="tab" class="{{tab==='reminders'?'selected':''}}">提醒</button><button data-tab="customers" bindtap="tab" class="{{tab==='customers'?'selected':''}}">客户</button><button data-tab="sync" bindtap="tab" class="{{tab==='sync'?'selected':''}}">设置</button></view>
  <view wx:if="{{message}}" class="feedback-banner">{{message}}</view>
  <block wx:if="{{tab==='reminders'}}">
    <view class="settings-card card"><view class="list-row"><view><view class="row-title">只看未读</view><view class="row-caption">待跟进的事情，一目了然</view></view><switch color="#007aff" checked="{{onlyUnread}}" bindchange="unread"/></view></view>
    <view class="group-note">提前两天、前一天和当天分级提示；逾期事项每日汇总。本次已跟进只关闭当前提醒。</view>
    <view wx:if="{{!reminders.length}}" class="empty card"><view class="empty-symbol"><view class="icon bell"></view></view><view class="empty-title">暂时没有待处理提醒</view><view class="empty-caption">新的跟进事项会显示在这里。</view></view>
    <view class="reminder-record card" wx:for="{{reminders}}" wx:key="id"><view class="record-heading"><view class="record-title">{{item.client}}</view><text class="pill {{item.unread?'red':'blue'}}">{{item.unread?'未读':'已读'}}</text></view><view class="reminder-label">{{item.label}}</view><view class="record-caption">{{item.pickupDate||'日期待核实'}}</view><view class="actions reminder-actions"><button data-id="{{item.taskId}}" bindtap="openTask">任务详情</button><button data-id="{{item.id}}" data-action="read" bindtap="reminder">标为已读</button><button data-id="{{item.id}}" data-action="snooze" bindtap="reminder">稍后1小时</button><button class="secondary" data-id="{{item.id}}" data-action="handled" bindtap="reminder">本次已跟进</button></view></view>
  </block>
  <block wx:if="{{tab==='customers'}}">
    <block wx:if="{{showCustomerForm}}"><view class="group-label">{{customer.id?'编辑客户档案':'新增客户档案'}}</view><view class="group-card">
      <view class="field"><text>企业全称</text><input value="{{customer.name}}" data-field="name" bindinput="customerInput" maxlength="100" placeholder="填写单位授权的企业名称"/></view>
      <view class="field"><text>企业别名</text><input value="{{customer.aliases}}" data-field="aliases" bindinput="customerInput" maxlength="500" placeholder="多个别名用逗号分隔"/></view>
      <view class="field"><text>联系人</text><input value="{{customer.contactName}}" data-field="contactName" bindinput="customerInput" placeholder="选填"/></view>
      <view class="field"><text>联系电话</text><input value="{{customer.phone}}" data-field="phone" bindinput="customerInput" placeholder="选填"/></view>
      <view class="field"><text>装货地址</text><input value="{{customer.address}}" data-field="address" bindinput="customerInput" maxlength="300" placeholder="选填"/></view>
      <view class="field"><text>合同到期日</text><picker mode="date" value="{{customer.contractExpiry}}" bindchange="date"><view class="picker-field"><text>{{customer.contractExpiry||'未核实可留空'}}</text><view class="chevron"></view></view></picker></view>
      <view class="field"><text>已核实的废物与包装信息</text><textarea value="{{customer.wasteNotes}}" data-field="wasteNotes" bindinput="customerInput" maxlength="2000" placeholder="记录实际信息，缺失内容保留待核实"/></view>
    </view><view class="customer-form-actions actions"><button bindtap="newCustomer">清空重填</button><button class="primary" bindtap="saveCustomer">保存客户档案</button></view><view class="group-note">历史任务保留创建时的客户信息，不会被新档案覆盖。</view></block>
    <view class="customer-search"><view class="icon search"></view><input placeholder="搜索客户、别名或电话" value="{{search}}" data-field="search" bindinput="input"/></view>
    <view wx:if="{{!customers.length}}" class="empty card"><view class="empty-symbol"><view class="icon people"></view></view><view class="empty-title">还没有匹配的客户</view><view class="empty-caption">建立档案，下次录入会更轻松。</view><button class="secondary" bindtap="newCustomer">新增客户</button></view>
    <view class="customer-record card" wx:for="{{customers}}" wx:key="id"><view class="record-heading"><view class="customer-avatar"><view class="icon people"></view></view><view class="customer-name-wrap"><view class="record-title">{{item.name}}</view><view class="record-caption">{{item.count}} 条历史清运</view></view></view><view wx:if="{{item.aliasesLabel}}" class="record-caption aliases">{{item.aliasesLabel}}</view><view class="contact-line">{{item.contactName||'联系人待补充'}} · {{item.phoneLabel}}</view><view wx:if="{{item.address}}" class="muted-text">{{item.address}}</view><view wx:if="{{item.contractExpiry}}" class="contract-date {{item.expired?'red-text':''}}">合同到期 {{item.contractExpiry}} · 请核实</view><view class="actions"><button class="secondary" data-id="{{item.id}}" bindtap="useCustomer">用于新任务</button><button data-id="{{item.id}}" bindtap="history">清运历史</button><button data-id="{{item.id}}" bindtap="editCustomer">编辑</button><button class="delete-action" data-id="{{item.id}}" bindtap="deleteCustomer">删除</button></view></view>
    <block wx:if="{{customerHistory.length}}"><view class="group-label">清运历史</view><view class="settings-card card"><view wx:for="{{customerHistory}}" wx:key="id" class="list-row history-row" data-id="{{item.id}}" bindtap="openTask"><view><view class="row-title">{{item.wasteName||'废物待核实'}}</view><view class="row-caption">{{item.pickupDate||'日期待定'}} · {{item.status}}</view></view><view class="chevron"></view></view></view></block>
  </block>
  <block wx:if="{{tab==='sync'}}">
    <view class="settings-card card"><view class="list-row"><view class="icon-tile green"><view class="icon cloud"></view></view><view class="service-copy"><view class="row-title">{{status.connected?'云端账户':'本地隐私模式'}}</view><view class="row-caption">{{status.connected?'草稿先保存到本机，点击同步后上传':'当前记录保存在这台设备'}}</view></view><text class="pill {{status.connected?'done':''}}">{{status.connected?'已登录':'本地'}}</text></view><view class="sync-summary"><view><text>{{status.pending||0}}</text><view>待同步</view></view><view><text>{{status.conflicts.length||0}}</text><view>待核对冲突</view></view></view></view>
    <block wx:if="{{!status.connected}}">
      <block wx:if="{{cloudEnabled}}"><view class="group-label">微信云开发</view><view class="settings-card card"><view class="row-title">使用当前微信账号同步</view><view class="notice">同一微信账号可在不同设备同步记录。每位用户的数据独立保存，其他用户不能直接查看。</view><button class="primary cloud-connect" bindtap="cloudLogin" loading="{{connecting}}" disabled="{{connecting}}">连接微信云开发</button><view class="notice">旧记录保留在本机，登录后不会自动上传。首次使用可先生成备份，再主动迁移。</view></view></block>
      <view class="settings-card card"><button class="settings-row" bindtap="advancedLogin"><text>{{showAdvancedLogin?'收起自建服务登录':'自建同步服务（高级）'}}</text><view class="chevron"></view></button></view>
    </block>
    <block wx:if="{{!status.connected && showAdvancedLogin}}"><view class="group-label">连接单位批准的服务</view><view class="group-card"><view class="field"><text>服务根地址</text><input value="{{url}}" data-field="url" bindinput="input" placeholder="https://dispatch.example.com"/></view><view class="field"><text>业务员账号</text><input value="{{username}}" data-field="username" bindinput="input" placeholder="管理员分配的账号"/></view><view class="field"><text>密码</text><input password="true" value="{{password}}" data-field="password" bindinput="input" placeholder="请输入密码"/></view></view><view class="settings-button"><button class="primary" bindtap="login">登录同步服务</button></view><view class="group-note">登录不会上传原有本地记录。需要时，请主动选择备份并迁移。</view></block>
    <view wx:if="{{status.connected}}" class="settings-card card"><view class="actions sync-actions"><button class="primary" bindtap="sync">立即同步</button><button bindtap="logout">返回本地</button></view></view>
    <view wx:if="{{status.connected}}" class="settings-card card role-card"><view class="list-row"><view><view class="row-title">当前身份</view><view class="row-caption">{{memberCode?'身份码 '+memberCode:'正在联网验证'}}</view></view><text class="pill {{canManage?'blue':''}}">{{roleLabel}}</text></view><block wx:if="{{roleVerified && cloudProfile}}"><view class="field"><text>姓名或工号（单位内部显示）</text><input value="{{profileName}}" maxlength="40" bindinput="profileInput" placeholder="填写便于管理员识别的名称"/></view><button class="quiet-button" bindtap="saveProfile">保存姓名或工号</button></block><view wx:if="{{roleError}}" class="notice red-text">{{roleError}}</view><button class="quiet-button" bindtap="refreshAccess">重新验证身份</button></view>
    <block wx:if="{{canManage && roleVerified}}"><view class="group-label">管理员 · 数据与备份</view><view class="settings-card card admin-tools"><button class="settings-row" bindtap="backup"><text>生成当前账号备份</text><view class="chevron"></view></button><button class="settings-row" bindtap="shareBackup"><text>分享备份文件</text><view class="chevron"></view></button><button class="settings-row" bindtap="migrate"><text>备份并迁移本地记录</text><view class="chevron"></view></button><button class="settings-row" bindtap="rollback"><text>回滚本机迁移批次</text><view class="chevron"></view></button></view><view class="group-note">管理操作均会再次验证云端角色。备份仅含当前账号的数据，请保存至单位批准的位置。卸载小程序可能清除本机缓存与沙盒备份。</view></block>
    <view wx:else class="group-note staff-note">备份、迁移和回滚仅限联网验证后的管理员。日常客户、任务和提醒操作继续可用。</view>
    <block wx:if="{{showMemberAdmin && canManage}}"><view class="section-heading"><text>成员与权限</text><button class="quiet-button" loading="{{membersLoading}}" bindtap="loadMembers">刷新成员</button></view><view class="customer-search"><view class="icon search"></view><input value="{{memberSearch}}" bindinput="memberSearchInput" placeholder="搜索姓名、工号或身份码"/></view><view class="settings-card card member-card" wx:for="{{visibleMembers}}" wx:key="id"><view class="list-row"><view><view class="row-title">{{item.displayName}} {{item.isSelf?'（你）':''}}</view><view class="row-caption">身份码 {{item.code}} · {{item.active?'已启用':'已停用'}}</view></view><text class="pill {{item.role==='admin'?'blue':''}}">{{item.roleLabel}}</text></view><view class="actions member-actions"><picker range="{{['普通员工','管理员']}}" value="{{item.roleIndex}}" data-id="{{item.id}}" bindchange="memberRoleChange"><view class="member-role-button">调整角色 <view class="chevron"></view></view></picker><button data-id="{{item.id}}" bindtap="memberToggle" class="{{item.active?'delete-action':'secondary'}}">{{item.active?'停用成员':'启用成员'}}</button></view></view><view wx:if="{{!visibleMembers.length}}" class="group-note">暂无匹配成员。新使用者连接云端后会以普通员工身份出现在这里。</view><view class="group-note">始终保留至少一位启用的管理员。停用会阻止后续云端访问，不删除资料，也不能远程收回已缓存的数据。客户和任务仍按微信账号隔离。</view></block>
    <view wx:for="{{conflicts}}" wx:key="id" class="settings-card card conflict-card"><view class="section-title">有一条修改需要核对</view><view class="notice">{{item.message}}</view><view class="conflict-version">本机版本：{{item.localLabel}}</view><view class="conflict-version">云端版本：{{item.remoteLabel}}</view><view class="actions"><button data-index="{{index}}" data-choice="remote" bindtap="resolve">采用云端</button><button class="secondary" data-index="{{index}}" data-choice="local" bindtap="resolve">确认保留本地</button></view></view>
    <view class="group-label">微信官方服务通知</view><view class="settings-card card"><view class="list-row"><view><view class="row-title">订阅清运提醒</view><view class="row-caption">{{wechat.configured?'服务端已配置':'尚未配置通知服务'}}</view></view><text class="pill {{wechat.bound?'done':''}}">{{wechat.bound?'已绑定':'未绑定'}}</text></view><view class="notice">后台任务：{{wechat.workerEnabled?'已启用':'未启用，不自动发送'}}。客户端上报可用次数：{{wechat.reportedCredits||0}}，实际权限以微信校验为准。</view><view class="actions"><button disabled="{{!wechat.configured||!status.connected}}" bindtap="bindWechat">绑定当前微信</button><button class="secondary" disabled="{{!challenge}}" bindtap="subscribe">主动订阅一次提醒</button></view><view wx:for="{{wechat.deliveries}}" wx:key="day" class="delivery-line">{{item.day}} · {{item.status}} {{item.code||''}}</view></view><view class="group-note">通知只显示待办数量，客户详情需登录查看。不订阅不会发送；一次订阅不代表长期授权。每天最多一次合并通知，发送结果未知时不自动重试。</view>
  </block>
  <view class="footer-note">清运智办 · 让每一次跟进更有把握</view>
</view>
